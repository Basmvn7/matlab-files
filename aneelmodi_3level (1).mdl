    Block {
      BlockType		      SubSystem
      Name		      "Permanent Magnet\nSynchronous Machine"
      SID		      25
      Ports		      [1, 1, 0, 0, 0, 3]
      Position		      [300, 375, 390, 455]
      BlockMirror	      on
      NamePlacement	      "alternate"
      AncestorBlock	      "powerlib/Machines/Permanent Magnet\nSynchronous Machine"
      LibraryVersion	      "*1.1845"
      DialogController	      "POWERSYS.PowerSysDialog"
      CopyFcn		      "powericon('psbloadfunction',gcb,'gotofrom','UpdateGotoTag');"
      FontName		      "Verdana"
      FontSize		      11
      Permissions	      "NoReadOrWrite"
      MinAlgLoopOccurrences   off
      PropExecContextOutsideSubsystem off
      RTWSystemCode	      "Auto"
      FunctionWithSeparateData off
      Opaque		      off
      RequestExecContextInheritance off
      MaskHideContents	      off
      MaskType		      "Permanent Magnet Synchronous Machine"
      MaskDescription	      "Implements a 3-phase permanent magnet synchronous machine with sinusoidal or trapezoidal "
      "back EMF. The sinusoidal machine is modelled in the dq rotor reference frame and the trapezoidal machine is mode"
      "lled in the abc reference frame. Stator windings are connected in wye to an internal neutral point.\n\nThe prese"
      "t models are available only for the Sinusoidal back EMF machine type."
      MaskHelp		      "web(psbhelp);"
      MaskPromptString	      "Back EMF waveform: |Mechanical input:       |Preset model:              |---------------"
      "--  Show detailed parameters ----------------- |Stator phase resistance Rs (ohm):|Stator phase inductance Ls (H)"
      "|Inductances [ Ld(H) Lq(H) ]:|Specify:|Flux linkage established by magnets (V.s):|Voltage Constant (V_peak L-L /"
      " krpm):|Torque Constant (N.m / A_peak):|Back EMF flat area (degrees):|Inertia, friction factor and pole pairs [ "
      "J(kg.m^2)  F(N.m.s)  p() ]:|Pole pairs p ():|Initial conditions  [ wm(rad/s)  thetam(deg)  ia,ib(A) ]:|Sample ti"
      "me of powergui block|Sample time (-1 for inherited)"
      MaskStyleString	      "popup(Sinusoidal|Trapezoidal),popup(Torque Tm|Speed w),popup(No|01:  0.8 Nm 300 Vdc 3000 "
      "RPM - 0.8 Nm|02:  1.7 Nm 300 Vdc 3750 RPM - 1.7 Nm|03:  2.8 Nm 300 Vdc 4250 RPM - 3.2 Nm|04:  6 Nm 300 Vdc 4500 "
      "RPM - 6 Nm|05:  8 Nm 300 Vdc 2000 RPM - 10 Nm|06:  10 Nm 300 Vdc 2300 RPM - 14.2 Nm|07:  20 Nm 300 Vdc 2200 RPM "
      "- 33.9 Nm|08:  24 Nm 300 Vdc 2300 RPM - 41.4 Nm|09:  7.14 Nm 560 Vdc 5000 RPM - 8.3 Nm|10:  7.71 Nm 560 Vdc 5000"
      " RPM - 10.2 Nm|11:  26.13 Nm 560 Vdc 3000 RPM - 27.3 Nm|12:  35.17 Nm 560 Vdc 3000 RPM - 37.4 Nm|13:  42.09 Nm 5"
      "60 Vdc 3000 RPM - 45.6 Nm|14:  67.27 Nm 560 Vdc 1700 RPM - 70.2 Nm|15:  87.75 Nm 560 Vdc 3000 RPM - 97.96 Nm|16:"
      "  111 Nm 560 Vdc 3000 RPM - 126 Nm),checkbox,edit,edit,edit,popup(Flux linkage established by magnets (V.s)|Volt"
      "age Constant (V_peak L-L / krpm)|Torque Constant (N.m / A_peak)),edit,edit,edit,edit,edit,edit,edit,edit,edit"
      MaskTunableValueString  "off,off,off,off,off,off,off,on,on,on,on,off,off,on,off,on,on"
      MaskCallbackString      "powericon('PMSynchronousMachineCback',gcb);\npowericon('PMSynchronousMachineParam',gcb)"
      ";|powericon('PMSynchronousMachineCback',gcb);|powericon('PMSynchronousMachineCback',gcb);|powericon('PMSynchrono"
      "usMachineCback',gcb);||||powericon('PMSynchronousMachineCback',gcb);\npowericon('PMSynchronousMachineParam',gcb)"
      ";|powericon('PMSynchronousMachineParam',gcb);|powericon('PMSynchronousMachineParam',gcb);|powericon('PMSynchrono"
      "usMachineParam',gcb);|powericon('PMSynchronousMachineParam',gcb);|powericon('PMSynchronousMachineParam',gcb);\n|"
      "powericon('PMSynchronousMachineParam',gcb);|||"
      MaskEnableString	      "on,on,on,off,on,on,on,on,on,off,off,on,on,on,on,off,on"
      MaskVisibilityString    "on,on,on,off,on,off,on,on,on,on,on,off,on,off,on,off,on"
      MaskToolTipString	      "on,on,on,on,on,on,on,on,on,on,on,on,on,on,on,on,on"
      MaskVariables	      "FluxDistribution=@1;MechanicalLoad=&2;PresetModel=@3;ShowDetailedParameters=@4;Resistance=@"
      "5;Inductance=@6;dqInductances=@7;MachineConstant=@8;Flux=@9;VoltageCst=@10;TorqueCst=@11;Flat=@12;Mechanical=@13"
      ";PolePairs=@14;InitialConditions=@15;TsPowergui=@16;TsBlock=@17;"
      MaskInitialization      "block = gcb;\n[Ts,PM,WantBlockChoice,X,Y] = powericon('PMSynchronousMachineInit',block,"
      "TsPowergui,TsBlock,MechanicalLoad,FluxDistribution,MechanicalLoad,Resistance,Inductance,dqInductances,Flux,Flat,"
      "Mechanical,PolePairs,InitialConditions);\npowericon('SetInternalModels','set',block,WantBlockChoice);"
      MaskDisplay	      "plot(X.p1,Y.p1,X.p2,Y.p2,X.p3,Y.p3,X.p4,Y.p4,X.p5,Y.p5,X.p6,Y.p6,X.p7,Y.p7,X.p8,Y.p8,X.p9,Y.p"
      "9);\ncolor('blue')\nplot(X.p10,Y.p10)\n"
      MaskSelfModifiable      on
      MaskIconFrame	      off
      MaskIconOpaque	      off
      MaskIconRotate	      "port"
      MaskPortRotate	      "default"
      MaskIconUnits	      "autoscale"
      MaskValueString	      "Sinusoidal|Torque Tm|No|on|2.8750|8.5e-3|[8.5e-3,8.5e-3]|Flux linkage established by magn"
