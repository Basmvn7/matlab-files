	  FunctionWithSeparateData off
	  Opaque		  off
	  RequestExecContextInheritance	off
	  MaskHideContents	  off
	  MaskType		  "3-phase PLL"
	  MaskDescription	  "This Phase Locked Loop (PLL) system can be used  to synchronize on a set of variable frequency, "
	  "three-phase sinusoidal signals. If the Automatic Gain Control is enabled, the input (phase error) of the PLL regula"
	  "tor is scaled according to the input signal magnitude.\n\nFor optimal performance, the following settings are recom"
	  "mended:\n  [ Kp Ki  Kd ] = [ 180  3200  1 ]\n  \"Enable Automatic Gain Control\" checked\n\nInput 1: Vector contain"
	  "ing the normalized three-phase signals [Va Vb Vc]\nOutput 1:  Measured frequency (Hz) = w/(2pi)\nOutput 2:  Ramp w."
	  "t varying between  0 and 2*pi,\n     synchronized on zero crossings of the fundamental (positive-sequence) of phase"
	  " A. \nOutput 3: Vector [sin(wt) cos(wt)]"
	  MaskHelp		  "This block is part of a subset of blocks in the Extras library that does not have documentation associ"
	  "ated with it, other than the block mask description."
	  MaskPromptString	  "Initial inputs:[ Phase(degrees)   Frequency(Hz) ]|Regulator gains [ Kp  Ki  Kd ]|Enable Automat"
	  "ic Gain Control"
	  MaskStyleString	  "edit,edit,checkbox"
	  MaskTunableValueString  "on,on,on"
	  MaskCallbackString	  "||"
	  MaskEnableString	  "on,on,on"
	  MaskVisibilityString	  "on,on,on"
	  MaskToolTipString	  "on,on,on"
	  MaskVariables		  "Par_Init=@1;ParK=@2;AGC=@3;"
	  MaskInitialization	  "a=exp(j*2*pi/3);\na2=exp(-j*2*pi/3);\nKp=ParK(1);\nKi=ParK(2);\nif length(ParK)==2\n    Kd=0;"
	  "\nelse\n    Kd=ParK(3);\nend  \nPhase_Init=Par_Init(1);\nFinit=Par_Init(2);\npower_initmask();"
	  MaskDisplay		  "disp('')"
	  MaskSelfModifiable	  on
	  MaskIconFrame		  on
	  MaskIconOpaque	  off
	  MaskIconRotate	  "none"
	  MaskPortRotate	  "default"
	  MaskIconUnits		  "autoscale"
	  MaskValueString	  "[0 60]|[ 180 3200 1 ]|off"
